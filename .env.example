# Copy to .env for local development. Never commit real secrets.

# Used by Flask for session signing. Set a long random value in production.
SECRET_KEY=replace-with-a-long-random-string

# Local only. Do not enable debug on a public host.
FLASK_DEBUG=1

# The host sets PORT. The default for `python app.py` is 5000.
# PORT=5000

# When the team's RAG service is ready, set this to its answer endpoint.
# Harbor will POST {"message", "history"} and expect JSON {"reply", "sources"}.
# Leave it unset to use the labeled preview knowledge set.
# RAG_BACKEND_URL=http://127.0.0.1:8000/api/answer

# Seconds to wait for the RAG service before returning an error.
# RAG_TIMEOUT=30
